        /// GPO output value on zero-crossing event for channels 0-3 (2 bits per channel).
        register GpoValueZcdCfgCh0Ch3 {
            address: 0xE3,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

