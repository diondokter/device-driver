        /// GPIO direction (bit N = 0 -> input, bit N = 1 -> output). Only applies to pins set as GPIO in PinCfg.
        register GpioCfg {
            address: 0x07,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field gpio_cfg 7:0,
            },
        },
        /// GPO driver type (bit N = 0 -> open-drain, bit N = 1 -> push-pull).
        register GpoDriveCfg {
            address: 0x09,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field gpo_drive_cfg 7:0,
