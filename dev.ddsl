        /// High-threshold lower 4 bits [bits 7:4] and 4-bit hysteresis value [bits 3:0] for channel N.
        register HysteresisCh[8 stride 4] {
            address: 0x20,
            reset: 0xF0,
            fields: fieldset _ {
                size-bytes: 1,

