        /// ALERT pin driver type and assertion polarity/mode.
        register AlertPinCfg {
            address: 0x17,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// ALERT driver type (false = open-drain, true = push-pull).
                field alert_drive 2,
                /// ALERT assertion behavior.
                field alert_logic 1:0 -> _ as
                    /// ALERT pin assertion behavior.
                    enum AlertLogic {
                        /// ALERT is asserted low and held until flags are cleared.
                        ActiveLow: 0,
                        /// ALERT is asserted high and held until flags are cleared.
                        ActiveHigh: 1,
                        /// ALERT pulses low on each new alert event.
                        PulsedLow: 2,
                        /// ALERT pulses high on each new alert event.
                        PulsedHigh: 3,
