        },
        /// Oversampling ratio configuration.
        register OsrCfg {
            address: 0x03,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// Number of samples averaged per conversion result.
                field osr 2:0 -> _ as
                    /// Number of samples averaged per conversion result.
                    enum OversamplingRatio {
                        /// No averaging (single sample).
                        Osr1: 0,
                        /// Average 2 samples.
                        Osr2: 1,
                        /// Average 4 samples.
                        Osr4: 2,
                        /// Average 8 samples.
                        Osr8: 3,
                        /// Average 16 samples.
                        Osr16: 4,
                        /// Average 32 samples.
                        Osr32: 5,
                        /// Average 64 samples.
                        Osr64: 6,
                        /// Average 128 samples.
                        Osr128: 7,
                    },
            },
        },
        /// Operating mode, oscillator selection, and autonomous-mode clock divider.
        register OpmodeCfg {
            address: 0x04,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// On CRC error in autonomous mode, pause sequencing and force channels to analog inputs.
                field conv_on_err 7,
                /// Conversion initiation mode.
                field conv_mode 6:5 -> _ as
                    /// Selects how conversions are initiated.
                    enum ConvMode {
                        /// Conversions triggered by host (SCL-stretch, CNVST, or SPI frame).
                        Manual: 0,
                        /// Device runs conversions continuously at the configured rate.
                        Autonomous: 1,
                        /// Reserved.
                        Reserved: catch-all _,
                    },
                /// Oscillator select (false = high-speed, true = low-power).
                field osc_sel 4,
                /// Clock divider for autonomous-mode sampling rate.
                field clk_div 3:0,
            },
        },
        /// Per-channel function select (bit N = 0 -> AIN, bit N = 1 -> GPIO).
        register PinCfg {
            address: 0x05,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field pin_cfg 7:0,
            },
