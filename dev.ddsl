        /// High-threshold upper 8 bits [bits 11:4] for channel N.
        register HighThCh[8 stride 4] {
            address: 0x21,
            reset: 0xFF,
            fields: fieldset _ {
                size-bytes: 1,

                field high_threshold_msb 7:0,
            },
        },
        /// Low-threshold lower 4 bits [bits 7:4] and event counter threshold [bits 3:0] for channel N.
        register EventCountCh[8 stride 4] {
            address: 0x22,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

