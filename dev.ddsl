manifest foo {
    device S2Lp {
        default-byte-order: BE,
        register-address-type: u8,
        command-address-type: u8,
        buffer-address-type: u8,
        word-boundaries: "_:-: :bB:A1:1A:1a:a1:AAa",
        default-access: RW,

        /// The TX and RX fifo. Writing writes to TX, reading reads from RX.
        buffer fifo {
            address: 255,
        },
        /// Send the S2-LP to TX state for transmission.
        /// Valid from `READY` and `SYNTH_SETUP`.
        command TX {
            address: 96,
        },
        /// Send the S2-LP to RX state for reception.
        /// Valid from `READY` and `SYNTH_SETUP`.
        command RX {
            address: 97,
        },
        /// Go to READY state.
        /// Valid from `STANDBY`, `SLEEP` and `LOCK`.
        command READY {
            address: 98,
        },
        /// Go to STANDBY state.
        /// Valid from `READY` and `SYNTH_SETUP`.
        command STANDBY {
            address: 99,
        },
        /// Go to SLEEP state.
        /// Valid from `READY`, `SYNTH_SETUP` and `WAIT_SLEEP`.
        command SLEEP {
            address: 100,
        },
        /// Go to LOCK state by using the RX configuration of the synthesizer.
        /// Valid from `READY` and `SYNTH_SETUP`.
        command LOCK_RX {
            address: 101,
        },
        /// Go to LOCK state by using the TX configuration of the synthesizer.
        /// Valid from `READY` and `SYNTH_SETUP`.
        command LOCK_TX {
            address: 102,
        },
        /// Exit from TX or RX states and go to READY state.
        /// Valid from `TX` and `RX`.
        command ABORT {
            address: 103,
        },
        /// Reload the LDC timer with a pre-programmed value stored in registers.
        /// Valid from `ANY`.
        command LDC_RELOAD {
            address: 104,
        },
        /// Reset the S2-LP state machine and registers values.
        /// Valid from `ANY`.
        command RESET {
            address: 112,
        },
        /// Clean the RX FIFO.
        /// Valid from `ALL`.
        command FLUSH_RX_FIFO {
            address: 113,
        },
        /// Clean the TX FIFO.
        /// Valid from `ALL`.
        command FLUSH_TX_FIFO {
            address: 114,
        },
        /// Reload the packet sequence counter with the value stored in register.
        /// Valid from `ANY`.
        command SEQUENCE_UPDATE {
            address: 115,
        },
        register GPIO_CONF[4 stride 1] {
            address: 0,
            reset: 10,
            fields: fieldset _ {
                size-bytes: 1,
                bit-overlap: allow,
            
                field GPIO_MODE 1:0 -> _ as enum GPIO_MODE {
                    HiZ: 0,
                    Input: 1,
                    OutputLowPower: 2,
                    OutputHighPower: 3,
                },
                field GPIO_SELECT_OUTPUT 7:3 -> _ as enum GPIO_SELECT_OUTPUT {
                    /// nIRQ (interrupt request, active low)
                    Irq: 0,
                    /// POR inverted (active low)
                    POR: 1,
                    /// Wake-up timer expiration. `1` when WUT has expired
                    WakeUpTimerExpiration: 2,
                    /// Low battery detection. `1` when battery is below threshold setting
                    LowBatteryDetection: 3,
                    /// TX data internal clock output (TX data are sampled on the rising edge of it)
                    TxDataInternalClockOutput: 4,
                    /// TX state outputs a command information coming from the RADIO_TX block
                    TxStateCommandInfo: 5,
                    /// TX/RX FIFO almost empty flag
                    FifoAlmostEmpty: 6,
                    /// TX/RX FIFO almost full flag
                    FifoAlmostFull: 7,
                    /// RX data output
                    RxDataOutput: 8,
                    /// RX clock output (recovered from received data)
                    RxClockOutput: 9,
                    /// RX state indication. `1` when the S2-LP is transiting in the RX state
                    RxState: 10,
                    /// Device in a state other than SLEEP or STANDBY. `0` when in SLEEP/STANDBY
                    DeviceNotSleepOrStandby: 11,
                    /// Device in STANDBY state
                    DeviceStandby: 12,
                    /// Antenna switch signal used for antenna diversity
                    AntennaSwitch: 13,
                    /// Valid preamble detected flag
                    ValidPreableDetected: 14,
                    /// Sync word detected flag
                    SyncWordDetected: 15,
                    /// RSSI above threshold (same indication of CS register)
                    RssiThreshold: 16,
                    /// Reserved value
                    Reserved: default _,
                    /// TX or RX mode indicator (to enable an external range extender)
                    TxOrRxMode: 18,
                    /// VDD (to emulate an additional GPIO of the MCU, programmable by SPI)
                    VDD: 19,
                    /// GND (to emulate an additional GPIO of the MCU, programmable by SPI)
                    GND: 20,
                    /// External SMPS enable signal (active high)
                    ExternalSmps: 21,
                    /// Device in SLEEP state
                    DeviceSleep: 22,
                    /// Device in READY state
                    DeviceReady: 23,
                    /// Device in LOCK state
                    DeviceLock: 24,
                    /// Device waiting for a high level of the lock-detector output signal
                    WaitingForLockDetector: 25,
                    /// TX_DATA_OOK signal (internal control signal generated in the OOK analog smooth mode)
                    TxDataOok: 26,
                    /// Device waiting for a high level of the READY2 signal from XO
                    WaitingForReady2: 27,
                    /// Device waiting for timer expiration to allow PM block settling
                    WaitingForPmBlockSettling: 28,
                    /// Device waiting for end of VCO calibration
                    WaitingForEndOfVcoCalibration: 29,
                    /// Device enables the full circuitry of the SYNTH block
                    SynthBlockFullCircuitry: 30,
                },
                field GPIO_SELECT_INPUT 7:3 -> _ as enum GPIO_SELECT_INPUT {
                    /// 1 >> TX command
                    TxCommand: 0,
                    /// 1 >> RX command
                    RxCommand: 1,
                    /// TX data input for direct modulation
                    TxDataInput: 2,
                    /// Wake-up from external input (sensor output)
                    Wakeup: 3,
                    /// External clock @ 34.7 kHz (used for LDC modes timing)
                    ExternalClock: 4,
                    /// Not used
                    NotUsed: default _,
                },
            },
        },
        register SYNT {
            address: 5,
            reset: 1108748130,
            fields: fieldset _ {
                size-bytes: 4,
            
                /// Set the charge pump current according to the XTAL frequency (see Table 37. Table 34).
                field PLL_CP_ISEL 31:29,
                /// Synthesizer band select. This parameter selects the out-of loop
                /// divide factor of the synthesizer:
                /// - false: 4, band select factor for high band
                /// - true: 8, band select factor for middle band
                /// (see Section 5.3.1 RF channel frequency settings).
                field BS 28,
                /// The PLL programmable divider (see Section 5.3.1 RF channel frequency settings).
                field SYNT 27:0,
            },
        },
        /// Intermediate frequency setting for the analog RF synthesizer, default: 300 kHz, see Eq. (15).
        register IF_OFFSET_ANA {
            address: 9,
            reset: 42,
            fields: fieldset _ {
                size-bytes: 1,
            
                field value 7:0,
            },
        },
        /// Intermediate frequency setting for the digital shift-to-baseband circuits, default: 300 kHz, see Eq. (15).
        register IF_OFFSET_DIG {
            address: 10,
            reset: 184,
            fields: fieldset _ {
                size-bytes: 1,
            
                field value 7:0,
            },
        },
        /// Channel spacing setting, see Eq. (16).
        register ChSpace {
            address: 12,
            reset: 63,
            fields: fieldset _ {
                size-bytes: 1,
            
                field value 7:0,
            },
        },
        /// Channel number. This value is multiplied by the channel spacing and added to the synthesizer base frequency to generate the actual RF carrier frequency, see Eq. (16).
        register ChNum {
            address: 13,
            reset: 0,
            fields: fieldset _ {
                size-bytes: 1,
            
                field value 7:0,
            },
        },
        /// The mantissa value of the data rate equation, see Eq. (14).
        register MOD4 {
            address: 14,
            reset: 33579,
            fields: fieldset _ {
                size-bytes: 2,
            
                field value 15:0,
            },
        },
        register MOD2 {
            address: 16,
            reset: 119,
            fields: fieldset _ {
                size-bytes: 1,
            
                field ModulationType 7:4 -> _ as enum ModulationType {
                    /// 2-FSK
                    FSK2: 0,
                    /// 4-FSK
                    FSK4: 1,
                    /// 2-GFSK BT=1
                    GFSK2BT1: 2,
                    /// 4-GFSK BT=1
                    GFSK4BT1: 3,
                    /// ASK/OOK
                    AskOok: 5,
                    /// Unmodulated
                    Unmodulated: 7,
                    /// 2-GFSK BT=0.5
                    GFSK2BT0_5: 10,
                    /// 4-GFSK BT=0.5
                    GFSK4BT0_5: 11,
                    /// Invalid value, do not use
                    illegal: catch-all _,
                },
                /// The exponent value of the data rate equation (see Eq. (14) ).
                field DATARATE_E 3:0,
            },
        },
        register MOD1 {
            address: 17,
            reset: 3,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Enable the PA power interpolator (see Section 5.6.1 PA configuration).
                field PA_INTERP_EN 7,
                /// Enable frequency interpolator for the GFSK shaping (see Section 5.4.1.1 Gaussian shaping).
                field MOD_INTERP_EN 6,
                /// Select the constellation map for 4-(G)FSK or 2-(G)FSK modulations (see Table 41. Constellation mapping 2-(G)FSK and Table 42. Constellation mapping 4-(G)FSK).
                field CONST_MAP 5:4,
                /// The exponent value of the frequency deviation equation (see Eq. (10)).
                field FDEV_E 3:0,
            },
        },
        /// The mantissa value of the frequency deviation equation (see Eq. (10)).
        register MOD0 {
            address: 18,
            reset: 147,
            fields: fieldset _ {
                size-bytes: 1,
            
                field fdev_m 7:0,
            },
        },
        /// Receiver channel filter
        register ChFlt {
            address: 19,
            reset: 35,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// The mantissa value of the receiver channel filter (see Table 44. Channel filter words).
                field ChFlt_M 7:4,
                /// The exponent value of the receiver channel filter (see Table 44. Channel filter words).
                field ChFlt_E 3:0,
            },
        },
        /// Automatic frequency compensation register 2
        register AFC2 {
            address: 20,
            reset: 200,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Enable the freeze AFC correction upon sync word detection.
                field AFC_FREEZE_ON_SYNC 7,
                /// Enable the AFC correction.
                field AFC_ENABLED 6,
                field AFC_MODE 5 -> _ as enum AFC_MODE {
                    ClosedOnSlicer: 0,
                    ClosedOnSecondConversionStage: 1,
                },
            },
        },
        /// Automatic frequency compensation register 1
        register AFC1 {
            address: 21,
            reset: 24,
            fields: fieldset _ {
                size-bytes: 1,
            
                field AFC_FAST_PERIOD 7:0,
            },
        },
        /// Automatic frequency compensation register 0
        register AFC0 {
            address: 22,
            reset: 37,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// The AFC loop gain in fast mode (2's log).
                field AFC_FAST_GAIN 7:4,
                /// The AFC loop gain in slow mode (2's log).
                field AFC_SLOW_GAIN 3:0,
            },
        },
        /// RSSI filter
        register RSSI_FLT {
            address: 23,
            reset: 227,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Gain of the RSSI filter.
                field RSSI_FLT 7:4,
                /// Carrier sense mode (see Section 5.5.8.2 Carrier sense)
                field CS_MODE 3:2 -> _ as enum CS_MODE {
                    /// Static CS
                    StaticCS: 0,
                    /// Dynamic CS with 6dB dynamic threshold
                    DynamicCS6db: 1,
                    /// Dynamic CS with 12dB dynamic threshold
                    DynamicCS12db: 2,
                    /// Dynamic CS with 18dB dynamic threshold
                    DynamicCS18db: 3,
                },
            },
        },
        /// Signal detect threshold in 1 dB steps. The RSSI_TH can be converted in dBm using the formula RSSI_TH-146.
        register RSSI_TH {
            address: 24,
            reset: 40,
            fields: fieldset _ {
                size-bytes: 1,
            
                field value 7:0,
            },
        },
        /// Automatic gain control 4
        register AgcCtrl4 {
            address: 26,
            reset: 84,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Low threshold 0 for the AGC
                field LOW_THRESHOLD_0 7:4,
                /// Low threshold 1 for the AGC
                field LOW_THRESHOLD_1 3:0,
            },
        },
        /// Automatic gain control 3
        register AgcCtrl3 {
            address: 27,
            reset: 16,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Low threshold selection (defined in the AGCCTRL4). Bitmask for each attenuation step.
                field LOW_THRESHOLD_SEL 7:0,
            },
        },
        /// Automatic gain control 2
        register AgcCtrl2 {
            address: 28,
            reset: 34,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Enable the AGC algorithm to be frozen on SYNC
                field FREEZE_ON_SYNC 5,
                /// AGC measurement time
                field MEAS_TIME 3:0,
            },
        },
        /// Automatic gain control 1
        register AgcCtrl1 {
            address: 29,
            reset: 89,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// High threshold for the AGC
                field HIGH_THRESHOLD 7:4,
            },
        },
        /// Automatic gain control 0
        register AgcCtrl0 {
            address: 30,
            reset: 140,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Enable the AGC
                field AGC_ENABLE 7,
                /// Hold time for after gain adjustment for the AGC.
                field HOLD_TIME 5:0,
            },
        },
        register ANT_SELECT_CONF {
            address: 31,
            reset: 69,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Hold time for after gain adjustment for the AGC.
                field EQU_CTRL 6:5 -> _ as try enum EQU_CTRL {
                    /// Equalization disabled
                    disabled: 0,
                    /// Single pass equalization
                    single_pass: 1,
                    /// Dual pass equalization
                    dual_pass: 2,
                },
                /// Do not fill the RX FIFO with data if the CS is threshold (see Section 5.5.9 CS blanking).
                field CS_BLANKING 4,
                /// Enable the antenna switching (see Section 5.5.10 Antenna switching).
                field AS_ENABLE 3,
                /// Set the measurement time.
                field AS_MEAS_TIME 2:0,
            },
        },
        /// Clock recovery 2
        register CLOCKREC2 {
            address: 32,
            reset: 192,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Clock recovery slow loop gain (log2).
                field CLK_REC_P_GAIN_SLOW 7:5,
                /// Symbol timing recovery algorithm selection
                field CLK_REC_ALGO_SEL 4 -> _ as enum CLK_REC_ALGO_SEL {
                    DLL: 0,
                    PLL: 1,
                },
                /// Set the integral slow gain for symbol timing recovery (PLL mode only).
                field CLK_REC_I_GAIN_SLOW 3:0,
            },
        },
        /// Clock recovery 1
        register CLOCKREC1 {
            address: 33,
            reset: 88,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Clock recovery fast loop gain (log2).
                field CLK_REC_P_GAIN_FAST 7:5,
                /// Post filter length
                field PstFlt_Len 4 -> _ as enum PstFlt_Len {
                    symbols8: 0,
                    symbols16: 1,
                },
                /// Set the integral fast gain for symbol timing recovery (PLL mode only).
                field CLK_REC_I_GAIN_FAST 3:0,
            },
        },
        /// Packet control 6
        register PcktCtrl6 {
            address: 43,
            reset: 32784,
            fields: fieldset _ {
                size-bytes: 2,
            
                /// The number of bits used for the SYNC field in the packet.
                field SYNC_LEN 15:10,
                /// The number of '01 or '10' of the preamble of the packet.
                field PREAMBLE_LEN 9:0,
            },
        },
        /// Packet control 4
        register PcktCtrl4 {
            address: 45,
            reset: 0,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// The number of bytes used for the length field.
                field LEN_WID 7 -> _ as enum LEN_WID {
                    bytes1: 0,
                    bytes2: 1,
                },
                /// Include the ADDRESS field in the packet.
                field ADDRESS_LEN 3,
            },
        },
        /// Packet control 3
        register PcktCtrl3 {
            address: 46,
            reset: 32,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// The number of bytes used for the length field.
                field PCKT_FRMT 7:6 -> _ as enum PacketFormat {
                    basic: 0,
                    ieee802_15_4g: 1,
                    uart_ota: 2,
                    stack: 3,
                },
                field RX_MODE 5:4 -> _ as try enum RX_MODE {
                    normal: 0,
                    direct_through_fifo: 1,
                    direct_through_gpio: 2,
                },
                /// Select the symbol mapping for 4(G)FSK.
                field FSK4_SYM_SWAP 3,
                /// Select the transmission order between MSB and LSB.
                field BYTE_SWAP 2,
                /// Select the preamble pattern.
                field PREAMBLE_SEL 1:0,
            },
        },
        /// Packet control 2
        register PcktCtrl2 {
            address: 47,
            reset: 0,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// This is the FCS type in header field of 802.15.4g packet.
                field FCS_TYPE_4G 5,
                /// - If the 802.15.4 mode is enabled, this is the FCS type in
                /// header field of 802.15.4g packet. Select the FEC type of
                /// 802.15.4g packet:
                ///  - 0: NRNSC
                ///  - 1: RSC.
                /// - If the UART packet is enabled, this is the value of the
                /// STOP_BIT.
                field FEC_TYPE_4G_OR_STOP_BIT 4,
                /// - If the 802.15.4 mode is enabled, 1: enable the interleaving
                /// of 802.15.4g packet.
                /// - If the UART packet is enabled, this is the value of the
                /// START_BIT.
                field INT_EN_4G_OR_START_BIT 3,
                /// Enable the 3-out-of-6 encoding/decoding.
                field MBUS_3OF6_EN 2,
                /// Enable the Manchester encoding/decoding.
                field MANCHESTER_EN 1,
                /// Packet length mode.
                field FIX_VAR_LEN 0 -> _ as enum FIX_VAR_LEN {
                    fixed: 0,
                    /// in variable mode the field LEN_WID of PCKTCTRL3 register must be configured
                    variable: 1,
                },
            },
        },
        /// Packet control 1
        register PcktCtrl1 {
            address: 48,
            reset: 44,
            fields: fieldset _ {
                size-bytes: 1,
            
                field CRC_MODE 7:5 -> _ as try enum CRC_MODE {
                    no_crc: 0,
                    crc_poly_0x07: 1,
                    crc_poly_0x8005: 2,
                    crc_poly_0x1021: 3,
                    crc_poly_0x864CBF: 4,
                    crc_poly_0x04C011BB7: 5,
                },
                /// Enable the whitening mode.
                field WHIT_EN 4,
                field TxSource 3:2 -> _ as enum TxSource {
                    normal: 0,
                    direct_through_fifo: 1,
                    direct_through_gpio: 2,
                    pn9: 3,
                },
                /// - In tx mode:
                ///  - false: select the primary SYNC word
                ///  - true: select the secondary SYNC word
                /// - In rx mode:
                ///  - true: enable the dual SYNC word detection mode
                field SECOND_SYNC_SEL 1,
                /// Enable the FEC encoding in TX or the Viterbi decoding in RX.
                field FEC_EN 0,
            },
        },
        /// Length of packet in bytes.
        register PcktLen {
            address: 49,
            reset: 20,
            fields: fieldset _ {
                size-bytes: 2,
            
                field value 15:0,
            },
        },
        /// SYNC word
        register SYNC {
            address: 51,
            reset: 2290649224,
            fields: fieldset _ {
                size-bytes: 4,
            
                field value 31:0,
            },
        },
        register QI {
            address: 55,
            reset: 1,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// SQI threshold.
                field SQI_TH 7:5,
                /// PQI threshold.
                field PQI_TH 4:1,
                /// Enable the SQI check.
                field SQI_EN 0,
            },
        },
        /// Set the packet postamble length.
        register PCKT_PSTMBL {
            address: 56,
            reset: 0,
            fields: fieldset _ {
                size-bytes: 1,
            
                field value 7:0,
            },
        },
        register PROTOCOL2 {
            address: 57,
            reset: 64,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Enable the CS value contributes to timeout disabling.
                field CS_TIMEOUT_MASK 7,
                /// Enable the SQI value contributes to timeout disabling.
                field SQI_TIMEOUT_MASK 6,
                /// Enable the PQI value contributes to timeout disabling.
                field PQI_TIMEOUT_MASK 5,
                /// TX sequence number to be used when counting reset is required using the related command.
                field TX_SEQ_NUM_RELOAD 4:3,
                /// - 0: select the almost empty/full control for TX FIFO.
                /// - 1: select the almost empty/full control for RX FIFO.
                field FIFO_GPIO_OUT_MUX_SEL 2,
                /// Set the LDC timer multiplier factor
                field LDC_TIMER_MULT 1:0 -> _ as enum LDC_TIMER_MULT {
                    x1: 0,
                    x2: 1,
                    x4: 2,
                    x8: 3,
                },
            },
        },
        register PROTOCOL1 {
            address: 58,
            reset: 0,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Enable the Low Duty Cycle mode.
                field LDC_MODE 7,
                /// Enable the LDC timer reload mode.
                field LDC_RELOAD_ON_SYNC 6,
                /// Enable the piggybacking.
                field PIGGYBACKING 5,
                /// Enable the RX sniff timer.
                field FAST_CS_TERM_EN 4,
                /// Enable the reload of the back-off random generator seed using the value written in the BU_COUNTER_SEED.
                field SEED_RELOAD 3,
                /// Enable the CSMA channel access mode.
                field CSMA_ON 2,
                /// Enable the CSMA persistent mode (no back-off cycles).
                field CSMA_PERS_ON 1,
                /// Enable the automatic packet filtering control.
                field AUTO_PCKT_FLT 0,
            },
        },
        register PROTOCOL0 {
            address: 59,
            reset: 8,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Max. number of re-TX (from 0 to 15)(0: re-transmission is not performed).
                field NMAX_RETX 7:4,
                /// Field NO_ACK=1 on transmitted packet.
                field NACK_TX 3,
                /// Enable the automatic acknowledgment if packet received request.
                field AUTO_ACK 2,
                /// Enable the persistent RX mode.
                field PERS_RX 1,
            },
        },
        /// Set the RX FIFO almost full threshold.
        register FIFO_CONFIG3 {
            address: 60,
            reset: 48,
            fields: fieldset _ {
                size-bytes: 1,
            
                field RX_AFTHR 6:0,
            },
        },
        /// Set the RX FIFO almost empty threshold.
        register FIFO_CONFIG2 {
            address: 61,
            reset: 48,
            fields: fieldset _ {
                size-bytes: 1,
            
                field RX_AETHR 6:0,
            },
        },
        /// Set the TX FIFO almost full threshold.
        register FIFO_CONFIG1 {
            address: 62,
            reset: 48,
            fields: fieldset _ {
                size-bytes: 1,
            
                field TX_AFTHR 6:0,
            },
        },
        /// Set the TX FIFO almost empty threshold.
        register FIFO_CONFIG0 {
            address: 63,
            reset: 48,
            fields: fieldset _ {
                size-bytes: 1,
            
                field TX_AETHR 6:0,
            },
        },
        /// Packet filter options
        register PCKT_FLT_OPTIONS {
            address: 64,
            reset: 64,
            fields: fieldset _ {
                size-bytes: 1,
            
                /// Logical Boolean function applied to CS/SQI/PQI values: 1: OR, 0: AND.
                field RX_TIMEOUT_AND_OR_SEL 6,
                /// RX packet accepted if its source field matches with RX_SOURCE_ADDR register
                field SOURCE_ADDR_FLT 4,
                /// RX packet accepted if its source field matches with BROADCAST_ADDR register.
                field DEST_VS_BROADCAST_ADDR 3,
                /// RX packet accepted if its destination address matches with MULTICAST_ADDR register.
                field DEST_VS_MULTICAST_ADDR 2,
                /// RX packet accepted if its destination address matches with RX_SOURCE_ADDR register.
                field DEST_VS_SOURCE_ADDR 1,
                /// Packet discarded if CRC is not valid.
                field CRC_FLT 0,
            },
        },
        /// Mask register for source address filtering.
        register PCKT_FLT_GOALS4 {
            address: 65,
            reset: 0,
            fields: fieldset _ {
                size-bytes: 1,
            
                field RX_SOURCE_MASK 7:0,
            },
        },
        /// If dual sync mode enabled: dual SYNC word byte 3, Otherwise RX packet source or TX packet destination field.
        register PCKT_FLT_GOALS3 {
            address: 66,
            reset: 0,
            fields: fieldset _ {
                size-bytes: 1,
            
                field RX_SOURCE_ADDR_OR_DUAL_SYNC3 7:0,
            },
        },
        /// If dual sync mode enabled: dual SYNC word byte 2, Broadcast address.
        register PCKT_FLT_GOALS2 {
            address: 67,
            reset: 0,
            fields: fieldset _ {
                size-bytes: 1,
            
                field BROADCAST_ADDR_OR_DUAL_SYNC2 7:0,
            },
        },
        /// If dual sync mode enabled: dual SYNC word byte 1, Multicast address.
