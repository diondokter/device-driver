                field ch3 7:6 -> _ as ZcdGpoValue,
                /// GPO value driven on rising/falling ZCD edge for CH2.
                field ch2 5:4 -> _ as ZcdGpoValue,
                /// GPO value driven on rising/falling ZCD edge for CH1.
                field ch1 3:2 -> _ as ZcdGpoValue,
                /// GPO value driven on rising/falling ZCD edge for CH0.
                field ch0 1:0 -> _ as ZcdGpoValue,
            },
        },
        /// GPO output value on zero-crossing event for channels 4-7 (2 bits per channel).
        register GpoValueZcdCfgCh4Ch7 {
            address: 0xE4,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// GPO value driven on rising/falling ZCD edge for CH7.
                field ch7 7:6 -> _ as ZcdGpoValue,
                /// GPO value driven on rising/falling ZCD edge for CH6.
                field ch6 5:4 -> _ as ZcdGpoValue,
                /// GPO value driven on rising/falling ZCD edge for CH5.
                field ch5 3:2 -> _ as ZcdGpoValue,
                /// GPO value driven on rising/falling ZCD edge for CH4.
                field ch4 1:0 -> _ as ZcdGpoValue,
            },
        },
        /// Enable GPO update on zero-crossing detection (bit N = 1 enables GPO[N]).
        register GpoZcdUpdateEn {
            address: 0xE7,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field gpo_zcd_update_en 7:0,
            },
        },
        /// Enable trigger-based GPO updates from alert events (bit N = 1 enables GPO[N]).
        register GpoTriggerCfg {
            address: 0xE9,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field gpo_trigger_update_en 7:0,
            },
        },
        /// Logic level to drive on each GPO when its trigger event fires (bit N = 1 -> high).
        register GpoValueTrig {
            address: 0xEB,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field gpo_value_on_trigger 7:0,
            },
        },

        /// GPO output value applied on a zero-crossing detection edge (rise/fall).
        /// Defined in Rust as `crate::ZcdGpoValue`; covers all 4 bit patterns, so
        /// the conversion is infallible.
        extern ZcdGpoValue -> u8 {
            infallible: allow,
            size-bits: 2,
        },
    }
}
