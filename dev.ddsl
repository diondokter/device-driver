        /// Logic level to drive on GPO outputs (bit N = 1 -> high).
        register GpoValue {
            address: 0x0B,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field gpo_value 7:0,
            },
        },
        /// GPI input logic level readback (bit N reflects GPIO[N]).
        register GpiValue {
            address: 0x0D,
            reset: 0x00,
            access: RO,
            fields: fieldset _ {
                size-bytes: 1,

                field gpi_value 7:0,
            },
        },
        /// Zero-crossing detection blanking time configuration.
        register ZcdBlankingCfg {
            address: 0x0F,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// Blanking time multiplier (false = 1x, true = 8x).
                field mult_en 7,
                /// Blanking time value (7-bit).
                field zcd_blanking 6:0,
            },
        },
        /// Channel sequencer mode and start/stop control.
        register SequenceCfg {
            address: 0x10,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// Start (true) or stop (false) the auto-sequence.
                field seq_start 4,
                /// Scanning mode selection.
                field seq_mode 1:0 -> _ as
                    /// Channel scanning mode for the sequencer.
                    enum SeqMode {
                        /// Host selects channel via MANUAL_CHID each conversion.
                        Manual: 0,
                        /// Sequencer cycles through channels enabled in AUTO_SEQ_CHSEL.
                        AutoSequence: 1,
                        /// Reserved.
                        Reserved: catch-all _,
                    },
            },
        },
        /// Channel ID for next conversion in manual mode.
        register ManualChSel {
            address: 0x11,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// Target channel (0-7 = AIN0-AIN7; channel must not be configured as GPIO).
                field manual_chid 3:0 -> _ as
                    /// Analog input channel selection.
                    enum ChannelId {
                        /// Analog input AIN0.
                        Ain0: 0,
                        /// Analog input AIN1.
                        Ain1: 1,
                        /// Analog input AIN2.
                        Ain2: 2,
                        /// Analog input AIN3.
                        Ain3: 3,
                        /// Analog input AIN4.
                        Ain4: 4,
                        /// Analog input AIN5.
                        Ain5: 5,
                        /// Analog input AIN6.
                        Ain6: 6,
                        /// Analog input AIN7.
                        Ain7: 7,
                        /// Reserved.
                        Reserved: catch-all _,
                    },
            },
        },
        /// Channel enable bitmask for auto-sequence (bit N = 1 includes AIN[N]).
        register AutoSeqChSel {
            address: 0x12,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field auto_seq_ch_sel 7:0,
            },
        },
        /// Channel alert enable for ALERT pin assertion (bit N = 1 enables CH[N]).
        register AlertChSel {
            address: 0x14,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field alert_ch_sel 7:0,
            },
        },
        /// Map CRC error condition to ALERT pin.
        register AlertFuncSel {
            address: 0x16,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// Assert ALERT pin when CRC_ERR_IN is set.
                field alert_crcin 0,
            },
