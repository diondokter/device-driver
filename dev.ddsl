            },
        },
        /// Combined alert event flags (OR of EventHighFlag and EventLowFlag per channel).
        register EventFlag {
            address: 0x18,
            reset: 0x00,
            access: RO,
            fields: fieldset _ {
                size-bytes: 1,

                /// Bit N = 1 indicates a pending alert event on CH[N].
                field event_flag 7:0,
            },
        },
        /// High-threshold (analog) or logic-1 (digital) alert flags. Write 1 to clear.
        register EventHighFlag {
            address: 0x1A,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// Bit N = 1 indicates a high alert on CH[N].
                field event_high_flag 7:0,
            },
        },
        /// Low-threshold (analog) or logic-0 (digital) alert flags. Write 1 to clear.
        register EventLowFlag {
            address: 0x1C,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// Bit N = 1 indicates a low alert on CH[N].
                field event_low_flag 7:0,
            },
        },
        /// Alert region selection per channel (bit N = 0 -> out-of-window, bit N = 1 -> in-window).
        register EventRgn {
            address: 0x1E,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                field event_rgn 7:0,
