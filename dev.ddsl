        /// General device configuration.
        register GeneralCfg {
            address: 0x01,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// Enable CRC appended to output data and CRC check on incoming data.
                field crc_en 6,
                /// Enable statistics module; clears and updates MAX/MIN/RECENT registers.
                field stats_en 5,
                /// Enable digital window comparator.
                field dwc_en 4,
                /// Write 1 to initiate conversion immediately without SCL stretching.
                field cnvst 3 WO,
                /// Force all channels to analog inputs regardless of PIN_CFG/GPIO_CFG.
                field ch_rst 2,
                /// Write 1 to initiate ADC offset calibration; auto-clears when complete.
                field cal 1,
                /// Write 1 to reset all registers to defaults.
                field rst 0 WO,
            },
        },
        /// Output data format configuration.
        register DataCfg {
            address: 0x02,
            reset: 0x00,
            fields: fieldset _ {
                size-bytes: 1,

                /// Output fixed debug code 0xA5A instead of ADC conversion data.
                field fix_pat 7,
                /// Append 4-bit channel ID or status flags to ADC output data.
                field append_status 5:4 -> _ as
                    /// Controls what is appended after the ADC output word.
                    enum AppendStatus {
                        /// No additional bits appended.
                        None: 0,
                        /// Append 4-bit channel ID.
                        ChannelId: 1,
                        /// Append 4-bit status flags.
                        StatusFlags: 2,
                        /// Reserved.
                        Reserved: catch-all _,
