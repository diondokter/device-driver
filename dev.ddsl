        /// Maximum ADC result upper byte for channel N. Resets to 0x00 after read.
        register MaxChMsb[8 stride 2] {
            address: 0x61,
            reset: 0x00,
            access: RO,
            fields: fieldset _ {
                size-bytes: 1,

