        /// Most-recent ADC result upper byte for channel N.
        register RecentChMsb[8 stride 2] {
            address: 0xA1,
            reset: 0x00,
            access: RO,
            fields: fieldset _ {
                size-bytes: 1,

                field value 7:0,
