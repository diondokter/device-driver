                        /// Compute RMS on AIN1.
                        Ain1: 1,
                        /// Compute RMS on AIN2.
                        Ain2: 2,
                        /// Compute RMS on AIN3.
                        Ain3: 3,
                        /// Compute RMS on AIN4.
                        Ain4: 4,
                        /// Compute RMS on AIN5.
                        Ain5: 5,
                        /// Compute RMS on AIN6.
                        Ain6: 6,
                        /// Compute RMS on AIN7.
                        Ain7: 7,
                        /// Reserved.
                        Reserved: catch-all _,
                    },
                /// Subtract DC component before computing RMS.
                field rms_dc_sub 2,
                /// Number of samples used for RMS accumulation.
                field rms_samples 1:0 -> _ as
                    /// Number of samples accumulated for the RMS calculation.
                    enum RmsSampleCount {
                        /// Accumulate 1024 samples.
                        Samples1024: 0,
                        /// Accumulate 4096 samples.
                        Samples4096: 1,
                        /// Accumulate 16384 samples.
                        Samples16384: 2,
                        /// Accumulate 65536 samples.
                        Samples65536: 3,
                    },
            },
        },
        /// RMS result lower byte.
        register RmsLsb {
            address: 0xC1,
            reset: 0x00,
            access: RO,
            fields: fieldset _ {
                size-bytes: 1,

                field value 7:0,
            },
        },
        /// RMS result upper byte.
        register RmsMsb {
            address: 0xC2,
            reset: 0x00,
            access: RO,
            fields: fieldset _ {
                size-bytes: 1,

                field value 7:0,
            },
        },
        /// Alert-event source bitmask for trigger-based update of GPO[N].
        register GpoTrigEventSel[8 stride 2] {
            address: 0xC3,
            reset: 0x02,
            fields: fieldset _ {
                size-bytes: 1,

                field trig_event_sel 7:0,
            },
