<!DOCTYPE html>
<html>

<head>
    {% let page_type = "Register" %}
    {% let title = method.name.original() %}
    {% include "temphead.html.j2" %}
</head>

<h1>Register {{ method.name.original() }}</h1>
<p>
    {{ self::description_to_html(&method.description) }}
</p>

<table>
    <tr>
        <th>Name</th>
        <th>Address</th>
        <th>Parent</th>
        <th>Repeat</th>
        <th>Access</th>
        <th>Fields</th>
    </tr>
    <tr>
        <td>{{ method.name.original() }}<br />{{ method.name.words_display() }}</td>
        <td>{{ method.address }}<br />{{ method.address | fmt("{:X}h") }}</td>
        <td>todo</td>
        <td>
            {% match &method.repeat %}
            {% when Repeat::None %}
            None
            {% when Repeat::Count { count, stride } %}
            {{count}} <small>stride</small> {{stride}}
            {% when Repeat::Enum { enum_name, stride, .. } %}
            {{enum_name.original()}}<small>stride</small>{{stride}}
            {% endmatch %}
        </td>
        <td>{{access}}</td>
        <td>{{fieldset_template.fieldset.name.original()}}</td>
    </tr>
</table>

<h2>Fields {{ fieldset_template.fieldset.name.original() }}</h2>

{{fieldset_template}}

</html>