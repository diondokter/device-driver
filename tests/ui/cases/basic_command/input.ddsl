device Device {
    default-byte-order: LE,
    command-address-type: u8,
    default-access: RW,

    command Foo {
        address: 0,

        fields-in: fieldset FooFieldSetIn {
            size-bytes: 3,

            field value 23:0 -> uint
        }
    },

    command Bar[4 stride 1] {
        address: 1
    },
}
